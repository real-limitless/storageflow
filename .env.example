SFTPGO_ADMIN_USERNAME=admin
SFTPGO_ADMIN_PASSWORD=CHANGE_ME
VFS_CACHE_MAX_SIZE=20G
VFS_WRITE_BACK=5s
# SOPS_AGE_KEY=
# MEDIA_MOUNT=./data/media
# PUID=1000
# PGID=1000
# APP_ENCRYPTION_KEY is generated by scripts/init-secrets.sh
# SEED_EMAIL=ada@acme.test
# SEED_PASSWORD is generated into .env
# POSTGRES_PASSWORD is generated into .env
# Dokploy (docker-compose.dokploy.yml) requires these names, with no default:
# POSTGRES_PASSWORD
# APP_ENCRYPTION_KEY
# SFTPGO_ADMIN_PASSWORD
# SEED_PASSWORD
# PUBLIC_ORIGIN
# STORAGEFLOW_SECRETS_DIR is optional. Unset uses named volume secrets-data.
# An absolute path bind-mounts that directory at /config.
# STORAGEFLOW_ENV=development
# RATE_LIMIT_ENABLED=1
# Per-route counters. Each name has a matching _WINDOW_MS in milliseconds.
# RATE_LIMIT_SIGNIN_IP=10
# RATE_LIMIT_SIGNIN_IP_WINDOW_MS=60000
# RATE_LIMIT_SIGNIN_ACCOUNT=5
# RATE_LIMIT_SIGNUP_IP=5
# RATE_LIMIT_SIGNUP_ACCOUNT=3
# Comma-separated proxy addresses allowed to set X-Forwarded-For and X-Real-IP.
# TRUSTED_PROXIES=
# ALLOW_PLAN_FLAG=1
# PUBLIC_ORIGIN=http://127.0.0.1:5173
# HOSTED_S3_BUCKET=acme-plain
# HOSTED_TENANT=acme
